{
  "name": "13_expand_group_detail",
  "steps": [
    {
      "type": "if",
      "condition": "document.querySelector('#process-section .btn-group-toggle:not([disabled])') === null",
      "children": [
        {
          "type": "abortTest",
          "message": "No multi-instance process group to expand. Have 2+ windows of the same app open on the test account and run this again."
        }
      ],
      "elseSteps": [
        {
          "type": "click",
          "selector": "#process-section .btn-group-toggle:not([disabled])",
          "parentSelectors": [],
          "value": ""
        },
        {
          "type": "waitFor",
          "selector": "",
          "parentSelectors": [],
          "value": "700"
        },
        {
          "type": "verifyElementVisible",
          "selector": "#process-section tr.group-detail",
          "parentSelectors": [],
          "value": ""
        },
        {
          "type": "verifyText",
          "selector": "#process-section tr.group-detail thead",
          "parentSelectors": [],
          "value": "glob:*PID*"
        },
        {
          "type": "verifyElementVisible",
          "selector": "#process-section tr.group-detail .process-name",
          "parentSelectors": [],
          "value": ""
        },
        {
          "type": "click",
          "selector": "#process-section .btn-group-toggle[aria-expanded=\"true\"]",
          "parentSelectors": [],
          "value": ""
        },
        {
          "type": "waitFor",
          "selector": "",
          "parentSelectors": [],
          "value": "500"
        },
        {
          "type": "if",
          "condition": "document.querySelector('#process-section .btn-group-toggle[aria-expanded=\"true\"]') !== null",
          "children": [
            {
              "type": "abortTest",
              "message": "The group toggle stayed expanded after the second click."
            }
          ]
        }
      ]
    }
  ],
  "uuid": "e5787fa3-3248-4a1c-8dc1-7f36f334511b"
}
