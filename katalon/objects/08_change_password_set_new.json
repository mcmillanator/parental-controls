      "type": "input",
      "selector": "#current",
      "parentSelectors": [],
      "value": "${ADMIN_PASSWORD}"
    },
    {
      "type": "input",
      "selector": "#new",
      "parentSelectors": [],
      "value": "${NEW_ADMIN_PASSWORD}"
    },
    {
      "type": "input",
      "selector": "#confirm",
      "parentSelectors": [],
      "value": "${NEW_ADMIN_PASSWORD}"
    },
    {
      "type": "click",
      "selector": "button[type=\"submit\"]",
      "parentSelectors": [],
      "value": ""
    },
    {
      "type": "waitFor",
      "selector": "",
      "parentSelectors": [],
