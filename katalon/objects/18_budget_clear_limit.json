      "type": "input",
      "selector": "#budget-${TEST_CATEGORY}-minutes",
      "parentSelectors": [],
      "value": "0"
    },
    {
      "type": "click",
      "selector": "#budget-${TEST_CATEGORY}-minutes + button",
      "parentSelectors": [],
      "value": ""
    },
    {
      "type": "waitFor",
      "selector": "",
      "parentSelectors": [],
      "value": "2000"
    },
    {
      "type": "verifyText",
      "selector": "#toast",
      "parentSelectors": [],
      "value": "glob:*Budget saved for*"
    },
    {
      "type": "if",
      "condition": "Array.from(document.querySelectorAll('.btn-freeze')).some(b => b.closest('td') && b.closest('td').id.indexOf('budget-status-') === 0)",
      "children": [
        {
          "type": "abortTest",
          "message": "The limit was not cleared: the budgets table still offers a Freeze button for this category."
        }
      ]
    }
  ],
  "uuid": "00e59670-07d7-4383-82ad-05dad06bca45"
