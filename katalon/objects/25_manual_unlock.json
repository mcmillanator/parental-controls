      "condition": "document.querySelector('#account-actions .btn-unlock') === null",
      "children": [
        {
          "type": "abortTest",
          "message": "The Unlock button is absent, so the test account is not locked. Run test case 08_manual_unlock_round_trip (it locks first), or lock the account by hand."
        }
      ],
      "elseSteps": [
        {
          "type": "click",
          "selector": "#account-actions .btn-unlock",
          "parentSelectors": [],
