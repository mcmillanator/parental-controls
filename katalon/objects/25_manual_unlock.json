          "selector": "",
          "parentSelectors": [],
          "value": ""
        },
        {
          "type": "waitFor",
          "selector": "",
          "parentSelectors": [],
          "value": "2000"
        },
        {
          "type": "verifyText",
          "selector": "#toast",
          "parentSelectors": [],
          "value": "glob:*Unlocked*"
        },
        {
          "type": "verifyElementVisible",
