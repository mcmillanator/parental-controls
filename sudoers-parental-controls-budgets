# Per-category app time budgets: allow the parental-controls app to freeze/thaw
# ONLY its own cgroups (parental-<username>-<category>) and to move PIDs into
# them. No signals, no SIGKILL anywhere in budget enforcement.
# Install as /etc/sudoers.d/parental-controls-budgets (mode 0440) and check
# with `visudo -c`.
#
# Both /usr/sbin and /usr/bin are listed: the code invokes bare names
# (`sudo tee`, `sudo cat`, `sudo mkdir`) and sudo resolves them via
# secure_path (sbin first). sudo matches on the path string.
#
# Paths are regex-anchored (^…$) and the category name is a single path segment
# ([A-Za-z0-9_.-]+, no slashes): a trailing-wildcard form such as
# `parental-*/cgroup.freeze` spans `/` in the argument, so
# `parental-x/../system.slice/sshd.service/cgroup.procs` also matched — an
# arbitrary PID migration/freeze primitive. `[.]` keeps dots literal; the
# username pattern matches the app's own validated username charset.
# See sudo-audit.md §2 and §5 Step 3.
@SERVICE_USER@ ALL=(root) NOPASSWD: ^/usr/sbin/tee /sys/fs/cgroup/parental-[A-Za-z0-9_.-]+/cgroup[.]freeze$, ^/usr/bin/tee /sys/fs/cgroup/parental-[A-Za-z0-9_.-]+/cgroup[.]freeze$
@SERVICE_USER@ ALL=(root) NOPASSWD: ^/usr/sbin/tee /sys/fs/cgroup/parental-[A-Za-z0-9_.-]+/cgroup[.]procs$, ^/usr/bin/tee /sys/fs/cgroup/parental-[A-Za-z0-9_.-]+/cgroup[.]procs$
@SERVICE_USER@ ALL=(root) NOPASSWD: ^/usr/sbin/cat /sys/fs/cgroup/parental-[A-Za-z0-9_.-]+/cgroup[.]freeze$, ^/usr/bin/cat /sys/fs/cgroup/parental-[A-Za-z0-9_.-]+/cgroup[.]freeze$
@SERVICE_USER@ ALL=(root) NOPASSWD: ^/usr/sbin/cat /sys/fs/cgroup/parental-[A-Za-z0-9_.-]+/cgroup[.]procs$, ^/usr/bin/cat /sys/fs/cgroup/parental-[A-Za-z0-9_.-]+/cgroup[.]procs$
@SERVICE_USER@ ALL=(root) NOPASSWD: ^/usr/sbin/mkdir -p /sys/fs/cgroup/parental-[A-Za-z0-9_.-]+$, ^/usr/bin/mkdir -p /sys/fs/cgroup/parental-[A-Za-z0-9_.-]+$
