[Unit]
Description=Health check for the parental-controls panel
After=network.target

[Service]
Type=oneshot
User=@SERVICE_USER@
WorkingDirectory=@APP_DIR@
ExecStart=/bin/bash @APP_DIR@/healthcheck.sh --host @BIND_HOST@ --port @BIND_PORT@
# Backstop for a wedged probe; curl's own --max-time (10s) is the first line
# of defence and a killed oneshot is still recorded as a failed unit.
TimeoutStartSec=60
Environment=PYTHONUNBUFFERED=1

# Filesystem hardening: the probe only reads (the app dir and the auth store
# are enough; it writes nothing, so ProtectSystem=strict costs it nothing).
ProtectSystem=strict
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectHostname=true
ProtectClock=true
LockPersonality=true
# NoNewPrivileges is safe here, unlike on parental-controls.service (documented
# there: the panel spawns passwordless sudo children). Keeping it here states
# that this unit can never escalate, which is also why it never restarts the
# panel -- that would need a sudo rule it must not have.
NoNewPrivileges=true

# No [Install]: this unit is triggered by its timer and must not be started
# by hand at boot.
