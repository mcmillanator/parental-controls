[Unit]
Description=Bazzite Parental Controls Web UI
After=network.target

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@APP_DIR@
ExecStart=/bin/bash -c 'cd @APP_DIR@ && . .venv/bin/activate && exec waitress-serve --host=@BIND_HOST@ --port=@BIND_PORT@ wsgi:application'
@TLS_EXECSTART@
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Auth store location (0600; owned by the service user so password changes,
# lockouts and revocations can persist — root can always read it).
Environment=PARENTAL_CONTROLS_AUTH=/etc/parental-controls/auth.json
@TLS_ENV_LINE@

# Filesystem hardening. The app dir holds writable JSON state; the auth
# store dir must stay writable for password changes/lockouts/revocation
# (startup refuses to run otherwise — fail closed).
#
# ProtectSystem=strict with /etc explicitly writable. Facts (observed
# 2026-10-10): ProtectSystem=full ALSO mounts /etc read-only on this system,
# so usermod still fails with "cannot lock /etc/passwd; try again later."
# Per-file ReadWritePaths for /etc/shadow and /etc/gshadow is impossible:
# both are mode 0000 and SELinux denies systemd's bind mount (init_t denied
# mounton on shadow_t), aborting the unit at the NAMESPACE step (exit 226).
# Directory-level /etc is therefore required for `sudo usermod` lock/unlock.
ProtectSystem=strict
ReadWritePaths=@APP_DIR@ /etc/parental-controls /etc
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectHostname=true
ProtectClock=true
LockPersonality=true

# DELIBERATELY ABSENT (documented, not an oversight):
# - NoNewPrivileges / RestrictSUIDSGID: the app enforces locks/freezes via
#   passwordless sudo children (usermod, loginctl, tee); either option
#   breaks setuid and would silently disable all enforcement.
# - ProtectControlGroups: budget enforcement writes cgroup.freeze via sudo
#   tee; masking the cgroup fs read-only would break freezing.
# Real confinement of those paths lives in the sudoers allowlist, which is
# scoped to exact binaries + parental-* cgroup paths (see
# sudoers-parental-controls-budgets; least-privilege sudoers review below).

[Install]
WantedBy=multi-user.target
